# Settings for deploy/compose.yml. Copy this file to .env next to compose.yml
# and adjust it:
#
#   cp .env.example .env && chmod 600 .env
#
# Empty values count as unset. All variables: docs/ops.md › Configuration.

# Required: public address of the app for links in emails and the OAuth
# redirect URI; replace the example host with your own. Without it, the server
# does not start.
ROEDY_PUBLIC_URL=https://mail.example.com

# Version of the image: 0.1 follows the patches of 0.1.x, 0.1.0 is exactly that
# version, empty means latest (docs/ops.md › Updates).
ROEDY_IMAGE_TAG=0.1

# User and group IDs the container runs as (default 65532, the image's user).
# Only change them together with a data directory that belongs to these IDs,
# e.g. a bind mount; never 0 (docs/ops.md › Container user).
ROEDY_UID=
ROEDY_GID=

# Log filter (default info) and format: json (default) or text.
ROEDY_LOG=
ROEDY_LOG_FORMAT=

# Number of reverse proxies in front of the server. compose.yml uses true (one
# proxy) as long as the variable is missing; set to empty, it turns it off. So
# leave it commented out unless you need a different value.
# ROEDY_TRUST_PROXY=true

# Instance key for secrets in the database: 64 hex characters
# (openssl rand -hex 32). Without it, the first start creates /data/secret.key.
# Back it up either way (docs/ops.md › Instance key). Alternatively a path to a
# file with the key inside the container, e.g. /run/secrets/roedy_secret_key;
# not both. compose.yml does not provide that file: add a Docker secret or a
# read-only volume for it there, otherwise the server does not start.
ROEDY_SECRET_KEY=
ROEDY_SECRET_KEY_FILE=

# Optional GeoIP database (MaxMind DB format) for locations in sessions and
# security emails, e.g. /geoip/GeoLite2-City.mmdb. Put the file into ./geoip and
# uncomment the volume ./geoip:/geoip:ro in compose.yml; it is off by default.
ROEDY_GEOIP_DB=
