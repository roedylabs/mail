{
  "name": "@roedy/web",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit SPA of Roedy Mail",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --silent",
    "check": "pnpm run sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker",
    "test": "pnpm run sync && vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@inlang/paraglide-js": "2.29.1",
    "@inlang/plugin-message-format": "4.5.5",
    "@playwright/test": "1.64.1",
    "@roedy/jmap": "workspace:*",
    "@roedy/tokens": "workspace:*",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tabler/icons-svelte-runes": "3.49.0",
    "@tanstack/virtual-core": "3.19.8",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "axe-core": "4.14.0",
    "dompurify": "3.4.17",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "qrcode": "1.5.4",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
